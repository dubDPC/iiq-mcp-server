# Incident IQ MCP server -- configuration
# Copy this file to `.env` (cp .env.example .env) and fill in your tenant's
# values. NEVER commit the real .env -- it holds your API token. Placeholders
# below are examples only.

# --- Required -------------------------------------------------------------
# Your tenant's API base URL. Replace YOURDISTRICT with your subdomain.
IIQ_BASE_URL=https://YOURDISTRICT.incidentiq.com/api/v1.0
# Your Incident IQ SiteId (GUID) -- from your IIQ admin / Developer Tools.
IIQ_SITE_ID=00000000-0000-0000-0000-000000000000
# Your Incident IQ ProductId (GUID) -- from your IIQ admin / Developer Tools.
IIQ_PRODUCT_ID=00000000-0000-0000-0000-000000000000
# A bearer API token for your IIQ tenant -- from your IIQ admin / Developer Tools.
IIQ_API_TOKEN=your-iiq-api-token
# The agent email the server acts as (used to match "assigned to me").
USER_EMAIL=you@yourdistrict.org
# Comma-separated Team GUIDs you triage (for the team-queue filter). May be one.
IIQ_TEAM_IDS=00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000001

# --- Optional -------------------------------------------------------------
# Your agent UUID. If set, skips the /users/me + /users lookup used to find it.
# IIQ_MY_USER_ID=00000000-0000-0000-0000-000000000000
# Alternative name for the same thing (either is honored; IIQ_AGENT_ID wins).
# IIQ_AGENT_ID=00000000-0000-0000-0000-000000000000
# Tenant ResolutionActionId (GUID) required to close on some tenants. If unset,
# resolve_ticket skips the resolution-action step. Set it if your tenant enforces one.
# IIQ_RESOLUTION_ACTION_ID=00000000-0000-0000-0000-000000000000
# WorkflowStep GUID for your closed/resolved status. If unset, it is discovered
# automatically by scanning a recently-closed ticket.
# IIQ_CLOSED_STATUS_ID=00000000-0000-0000-0000-000000000000
# Load .env from a non-default path (absolute). Default: ./.env next to server.py.
# IIQ_ENV_PATH=/absolute/path/to/.env
